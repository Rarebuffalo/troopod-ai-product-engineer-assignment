{% comment %}
  Renders a Purelane custom product card.
  Accepts:
  - card_product: {Object} Product object (required)
  - show_badge: {Boolean} Whether to show the custom badge (optional, default: true)
{% endcomment %}

{%- assign show_badge = show_badge | default: true -%}
{%- assign card_badge = card_product.metafields.custom.card_badge.value -%}
{%- assign product_summary = card_product.metafields.custom.product_summary.value -%}

<article class="pl-glass pl-card pl-rv {% unless card_product.available %}pl-card--sold-out{% endunless %}">
  <div class="pl-card-shot">
    {%- if show_badge and card_badge != blank -%}
      <span class="pl-card-badge-pill">{{ card_badge }}</span>
    {%- elsif show_badge and card_product.available == false -%}
      <span class="pl-card-badge-pill pl-card-badge-pill--sold-out">Sold out</span>
    {%- endif -%}

    <a href="{{ card_product.url | default: '#' }}" class="pl-card-image-link" aria-label="View {{ card_product.title | escape }}">
      {%- if card_product.featured_media != blank -%}
        {{ card_product.featured_media | image_url: width: 320 | image_tag:
          loading: 'lazy',
          class: 'pl-card-img',
          sizes: '(min-width: 960px) 25vw, 50vw',
          alt: card_product.featured_media.alt | escape
        }}
      {%- else -%}
        {% comment %} Dynamic visual fallback for product with no image {% endcomment %}
        <div class="pl-card-img-placeholder">
          <svg viewBox="0 0 130 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img">
            <defs>
              <linearGradient id="gPlchb" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#ffffff" stop-opacity=".10"/>
                <stop offset=".18" stop-color="#ffffff" stop-opacity=".38"/>
                <stop offset=".5" stop-color="#dff3e4" stop-opacity=".10"/>
                <stop offset=".82" stop-color="#ffffff" stop-opacity=".22"/>
                <stop offset="1" stop-color="#9fc7b4" stop-opacity=".32"/>
              </linearGradient>
              <linearGradient id="gPlchl" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#04756e"/>
                <stop offset=".55" stop-color="#4b3a8f"/>
                <stop offset="1" stop-color="#013f3d"/>
              </linearGradient>
              <linearGradient id="gPlchc" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#8fa89b"/>
                <stop offset=".22" stop-color="#eef6ef"/>
                <stop offset="1" stop-color="#7d938c"/>
              </linearGradient>
            </defs>
            <ellipse cx="65" cy="190" rx="40" ry="7" fill="#01201c" opacity=".5"/>
            <path d="M40 60V48c0-7 5-12 12-12h13c8 0 13 6 13 13v11Z" fill="url(#gPlchc)"/>
            <path d="M65 37c11-1 19 3 25 10 3 4 2 9-2 10l-20 3Z" fill="#cfdcd2"/>
            <path d="M14 44h27v9H19c-4 0-6-2-6-4s1-5 1-5Z" fill="#cfdcd2"/>
            <path d="M44 52c-7 3-11 9-10 16 1 6 5 10 12 10v-6c-4 0-6-2-6-5s2-6 5-7Z" fill="#cfdcd2"/>
            <rect x="38" y="56" width="42" height="7" rx="3" fill="#a8bdb2"/>
            <rect x="41" y="62" width="36" height="16" rx="4" fill="url(#gPlchc)"/>
            <path d="M28 96c0-11 6-18 15-24v-8h33v8c9 6 15 13 15 24v62c0 12-8 20-21 20H49c-13 0-21-8-21-20Z" fill="url(#gPlchb)" stroke="rgba(255,255,255,.4)" stroke-width="1.4"/>
            <rect x="31" y="112" width="66" height="60" rx="6" fill="url(#gPlchl)"/>
            <rect x="31" y="112" width="66" height="60" rx="6" fill="none" stroke="rgba(236,230,247,.26)" stroke-width="1"/>
            <g transform="translate(58 120) scale(.5)" fill="none" stroke="#f0a03c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
            </g>
            <text x="64" y="140" text-anchor="middle" font-family="Outfit, sans-serif" font-size="8.6" font-weight="800" letter-spacing=".7" fill="#faf7fd">PURELANE</text>
            <line x1="42" y1="146" x2="86" y2="146" stroke="#f0a03c" stroke-width=".9" opacity=".85"/>
            <text x="64" y="156" text-anchor="middle" font-family="Inter, sans-serif" font-size="6.4" font-weight="700" letter-spacing="1.1" fill="#ece6f7">CLEANSE</text>
            <text x="64" y="164" text-anchor="middle" font-family="Inter, sans-serif" font-size="6.4" font-weight="700" letter-spacing="1.1" fill="#ece6f7">FORMULA</text>
          </svg>
        </div>
      {%- endif -%}
    </a>
  </div>

  <div class="pl-card-body">
    <h4 class="pl-card-title">
      <a href="{{ card_product.url | default: '#' }}">{{ card_product.title | default: 'Purelane Product' }}</a>
    </h4>
    
    {%- if product_summary != blank -%}
      <p class="pl-card-summary">{{ product_summary }}</p>
    {%- endif -%}

    {% comment %} Renders static rating from design mockup as fallback if reviews app is not integrated {% endcomment %}
    <div class="pl-card-rate">
      <b>★ 4.8</b> · 237 reviews
    </div>

    <div class="pl-card-price-row">
      {%- if card_product -%}
        <strong>{{ card_product.price | money }}</strong>
        {%- if card_product.compare_at_price > card_product.price -%}
          <s>{{ card_product.compare_at_price | money }}</s>
          {%- assign discount = card_product.compare_at_price | minus: card_product.price | times: 100.0 | divided_by: card_product.compare_at_price | round -%}
          <em class="pl-card-discount-lbl">{{ discount }}% off</em>
        {%- endif -%}
      {%- else -%}
        <strong>₹200</strong>
        <s>₹299</s>
        <em class="pl-card-discount-lbl">33% off</em>
      {%- endif -%}
    </div>

    {%- if card_product.available -%}
      <button 
        class="pl-btn pl-btn-ghost pl-btn-sm pl-card-add-btn" 
        type="button" 
        data-variant-id="{{ card_product.first_available_variant.id }}"
        aria-label="Add {{ card_product.title | escape }} to cart"
      >
        Add to cart
      </button>
    {%- else -%}
      <button 
        class="pl-btn pl-btn-ghost pl-btn-sm pl-card-add-btn pl-card-add-btn--disabled" 
        type="button" 
        disabled
        aria-label="{{ card_product.title | escape }} is sold out"
      >
        Sold out
      </button>
    {%- endif -%}
  </div>
</article>
