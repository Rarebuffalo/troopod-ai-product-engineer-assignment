<section class="purelane-section-wrapper" data-scene="1">
  <div class="pl-wrap">
    <div style="padding: 100px 0; text-align: center;">
      <h1 class="pl-d1">{{ section.settings.title }}</h1>
      <p class="pl-lede" style="margin: 20px auto;">{{ section.settings.subheading }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "class": "purelane-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Clean That Lasts"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime, made from plants."
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero"
    }
  ]
}
{% endschema %}
