{% comment %}
  Purelane Announcement Ticker Section
  Renders the infinite scrolling promotional banner.
{% endcomment %}

<div class="pl-ticker" aria-hidden="true" id="purelane-ticker-{{ section.id }}" style="--tick-speed: {{ section.settings.speed }}s;">
  <div class="pl-track">
    {%- for i in (1..3) -%}
      {%- for block in section.blocks -%}
        <span {{ block.shopify_attributes }}>
          {{ block.settings.text }}
          {%- if block.settings.bold_text != blank -%}
            <b>{{ block.settings.bold_text }}</b>
          {%- endif -%}
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Purelane Ticker",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll Animation Duration",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "ticker_item",
      "name": "Ticker Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Normal Text",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "bold_text",
          "label": "Bold Text",
          "default": "on every bundle across India"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Ticker",
      "blocks": [
        {
          "type": "ticker_item",
          "settings": {
            "text": "Free shipping",
            "bold_text": "on every bundle across India"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "text": "100% plant-based",
            "bold_text": "and non-toxic"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "text": "Loved by",
            "bold_text": "30,000+ happy homes"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "text": "Buy 3",
            "bold_text": "at flat ₹499"
          }
        }
      ]
    }
  ]
}
{% endschema %}
