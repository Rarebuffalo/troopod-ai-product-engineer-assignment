{% comment %}
  Purelane Bundle Categories Section
  Displays the grid of different bundle types with dynamic fallback illustrations or image override settings.
{% endcomment %}

<section class="pl-sec" id="categories" data-scene="4">
  <div class="pl-wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="panel-head pl-rv" style="margin-bottom: 24px;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="pl-kicker">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="pl-body-s" style="margin-top: 8px; max-width: 44ch;">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pl-cats">
      {%- for block in section.blocks -%}
        {%- assign target_link = block.settings.cta_link -%}
        {%- if block.settings.collection != blank and target_link == blank -%}
          {%- assign target_link = collections[block.settings.collection].url -%}
        {%- endif -%}
        {%- assign target_link = target_link | default: '#combos' -%}
        
        {%- assign animation_delay_class = '' -%}
        {%- assign index_modulo = forloop.index0 | modulo: 4 -%}
        {%- if index_modulo == 1 -%}
          {%- assign animation_delay_class = 'pl-rv-d1' -%}
        {%- elsif index_modulo == 2 -%}
          {%- assign animation_delay_class = 'pl-rv-d2' -%}
        {%- elsif index_modulo == 3 -%}
          {%- assign animation_delay_class = 'pl-rv-d3' -%}
        {%- endif -%}

        <a 
          class="pl-glass pl-cat pl-rv {{ animation_delay_class }}" 
          href="{{ target_link }}"
          {{ block.shopify_attributes }}
        >
          <span class="pl-cat-ph">
            {%- if block.settings.featured_image != blank -%}
              {{ block.settings.featured_image | image_url: width: 360 | image_tag: class: 'pimg', alt: block.settings.title }}
            {%- else -%}
              <span class="pimg {{ block.settings.illustration_class }}" role="img" aria-label="Purelane {{ block.settings.title | escape }}"></span>
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="pl-badge" style="position: absolute; top: 12px; right: 12px; z-index: 2; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 3px 6px; border-radius: 6px; background: var(--pl-accent); color: #fff;">
                {{ block.settings.badge | escape }}
              </span>
            {%- endif -%}
          </span>
          <span class="pl-cat-txt">
            <h4>{{ block.settings.title | escape }}</h4>
            <p>{{ block.settings.description | escape }}</p>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle Categories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description (Optional)"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Bundle Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short Description",
          "default": "Grease, dishes & more"
        },
        {
          "type": "image_picker",
          "id": "featured_image",
          "label": "Featured Image (Overrides illustration)"
        },
        {
          "type": "select",
          "id": "illustration_class",
          "label": "Illustration Fallback",
          "options": [
            { "value": "p-kitchen", "label": "Kitchen Cleaner" },
            { "value": "p-toilet", "label": "Toilet Cleaner" },
            { "value": "p-laundry", "label": "Laundry Detergent" },
            { "value": "p-tap", "label": "Tap Cleaner" },
            { "value": "p-floor", "label": "Floor Cleaner" },
            { "value": "p-dish", "label": "Dishwash Gel" },
            { "value": "p-metal", "label": "Copper Cleaner" },
            { "value": "p-wm", "label": "Washing Machine Cleaner" },
            { "value": "p-handwash", "label": "Handwash" },
            { "value": "p-eraser", "label": "Magic Eraser" }
          ],
          "default": "p-kitchen"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Linked Collection"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (Optional)"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Text",
          "default": "Shop Bundle"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA Link",
          "default": "/collections"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Categories",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "title": "Kitchen bundle",
            "description": "Grease, dishes & more",
            "illustration_class": "p-kitchen",
            "cta_link": "#combos"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Bathroom bundle",
            "description": "Deep clean & disinfect",
            "illustration_class": "p-toilet",
            "cta_link": "#combos"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Laundry bundle",
            "description": "Softer, fresher wash",
            "illustration_class": "p-laundry",
            "cta_link": "#combos"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Hard water bundle",
            "description": "Melt away limescale",
            "illustration_class": "p-tap",
            "cta_link": "#combos"
          }
        }
      ]
    }
  ]
}
{% endschema %}
