{% comment %}
  Purelane Trust Bar Section
  Displays the 4-column value props / brand trust characteristics.
{% endcomment %}

<section class="pl-sec" data-scene="4">
  <div class="pl-wrap">
    <div class="pl-glass pl-trust pl-rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
          <div class="pl-trust-i" {{ block.shopify_attributes }}>
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
              {%- when 'box' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M4 8 6.5 3h11L20 8M9.5 12h5"/></svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
              {%- when 'globe' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/></svg>
            {%- endcase -%}
            <span>{{ block.settings.text | newline_to_br }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Plant Derived (Leaf)" },
            { "value": "box", "label": "Recyclable Packaging (Box)" },
            { "value": "heart", "label": "Safe (Heart)" },
            { "value": "globe", "label": "Made in India (Globe)" }
          ],
          "default": "leaf"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Label Text",
          "default": "Plant derived\nformulas"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "leaf",
            "text": "Plant derived\nformulas"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "box",
            "text": "Recyclable\npackaging"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "heart",
            "text": "Safe for\nkids & pets"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "globe",
            "text": "Made in\nIndia"
          }
        }
      ]
    }
  ]
}
{% endschema %}
{% comment %} force-sync-1 {% endcomment %}
