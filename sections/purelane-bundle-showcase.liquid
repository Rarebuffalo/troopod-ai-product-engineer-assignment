{% comment %}
  Purelane Bundle Showcase Section (Best Selling Combos)
  Displays the horizontal scrolling list of pre-configured bundle cards.
{% endcomment %}

<section class="pl-sec" id="combos" data-scene="3">
  <div class="pl-wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="panel-head pl-rv" style="margin-bottom: 24px;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="pl-kicker">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <div class="pl-rule" style="display: flex; align-items: center; justify-content: center; gap: 10px; margin: 12px 0 0; opacity: 0.35;">
          <span style="flex: 0 0 30px; height: 1px; background: currentColor;"></span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          <span style="flex: 0 0 30px; height: 1px; background: currentColor;"></span>
        </div>
        {%- if section.settings.description != blank -%}
          <p class="pl-lede" style="margin: 14px auto 0; max-width: 50ch;">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pl-comborail pl-rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'bundle' -%}
          <article class="pl-glass pl-combo {% if block.settings.is_hero %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
            <div class="pl-combo-tray">
              {%- if block.settings.badge_save != blank -%}
                <span class="pl-combo-save">{{ block.settings.badge_save | escape }}</span>
              {%- endif -%}
              {%- if block.settings.badge_flag != blank -%}
                <span class="pl-combo-flag">{{ block.settings.badge_flag | escape }}</span>
              {%- endif -%}

              <div class="pl-combo-stack">
                {%- comment -%}Render product 1{%- endcomment -%}
                {%- if block.settings.product_1 != blank or block.settings.product_1_tag != blank -%}
                  <span class="pl-combo-it">
                    {%- if block.settings.product_1_illustration == 'tile-fabric' -%}
                      <span class="tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                        </svg>
                      </span>
                    {%- else -%}
                      <span class="pimg {{ block.settings.product_1_illustration }}" role="img" aria-label="{{ block.settings.product_1_tag | escape }}"></span>
                    {%- endif -%}
                    {%- if block.settings.product_1_tag != blank -%}
                      <span>{{ block.settings.product_1_tag | escape }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}

                {%- comment -%}Render product 2{%- endcomment -%}
                {%- if block.settings.product_2 != blank or block.settings.product_2_tag != blank -%}
                  <span class="pl-combo-plus" aria-hidden="true">+</span>
                  <span class="pl-combo-it">
                    {%- if block.settings.product_2_illustration == 'tile-fabric' -%}
                      <span class="tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                        </svg>
                      </span>
                    {%- else -%}
                      <span class="pimg {{ block.settings.product_2_illustration }}" role="img" aria-label="{{ block.settings.product_2_tag | escape }}"></span>
                    {%- endif -%}
                    {%- if block.settings.product_2_tag != blank -%}
                      <span>{{ block.settings.product_2_tag | escape }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}

                {%- comment -%}Render product 3{%- endcomment -%}
                {%- if block.settings.product_3 != blank or block.settings.product_3_tag != blank -%}
                  <span class="pl-combo-plus" aria-hidden="true">+</span>
                  <span class="pl-combo-it">
                    {%- if block.settings.product_3_illustration == 'tile-fabric' -%}
                      <span class="tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                        </svg>
                      </span>
                    {%- else -%}
                      <span class="pimg {{ block.settings.product_3_illustration }}" role="img" aria-label="{{ block.settings.product_3_tag | escape }}"></span>
                    {%- endif -%}
                    {%- if block.settings.product_3_tag != blank -%}
                      <span>{{ block.settings.product_3_tag | escape }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}

                {%- comment -%}Render product 4{%- endcomment -%}
                {%- if block.settings.product_4 != blank or block.settings.product_4_tag != blank -%}
                  <span class="pl-combo-plus" aria-hidden="true">+</span>
                  <span class="pl-combo-it">
                    {%- if block.settings.product_4_illustration == 'tile-fabric' -%}
                      <span class="tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                        </svg>
                      </span>
                    {%- else -%}
                      <span class="pimg {{ block.settings.product_4_illustration }}" role="img" aria-label="{{ block.settings.product_4_tag | escape }}"></span>
                    {%- endif -%}
                    {%- if block.settings.product_4_tag != blank -%}
                      <span>{{ block.settings.product_4_tag | escape }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}

                {%- comment -%}Render product 5{%- endcomment -%}
                {%- if block.settings.product_5 != blank or block.settings.product_5_tag != blank -%}
                  <span class="pl-combo-plus" aria-hidden="true">+</span>
                  <span class="pl-combo-it">
                    {%- if block.settings.product_5_illustration == 'tile-fabric' -%}
                      <span class="tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                        </svg>
                      </span>
                    {%- else -%}
                      <span class="pimg {{ block.settings.product_5_illustration }}" role="img" aria-label="{{ block.settings.product_5_tag | escape }}"></span>
                    {%- endif -%}
                    {%- if block.settings.product_5_tag != blank -%}
                      <span>{{ block.settings.product_5_tag | escape }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </div>
            </div>

            <div class="body">
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.subtitle != blank -%}
                <div class="cnt">{{ block.settings.subtitle | escape }}</div>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="inc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
              
              <div class="prow">
                <strong>{{ block.settings.price | escape }}</strong>
                {%- if block.settings.compare_price != blank -%}
                  <s>{{ block.settings.compare_price | escape }}</s>
                {%- endif -%}
                {%- if block.settings.savings_highlight != blank -%}
                  <em>{{ block.settings.savings_highlight | escape }}</em>
                {%- endif -%}
              </div>

              {%- if block.settings.fine_print != blank -%}
                <div class="fine">{{ block.settings.fine_print | escape }}</div>
              {%- endif -%}

              <a class="btn {% if block.settings.is_hero %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.cta_link | default: '#bundles' }}">
                {{ block.settings.cta_text | escape }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width: 13px; height: 13px; margin-left: 6px;"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.swipe_hint != blank -%}
      <div class="pl-swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        {{ section.settings.swipe_hint | escape }}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="pl-railnote">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</section>

