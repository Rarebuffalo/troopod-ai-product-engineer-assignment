{% comment %}
  Purelane Bundle Tiers Section (Build Your Bundle)
  Displays the options for bundle boxes (2, 3, or 5 products) with customizable prices, tags, and content.
{% endcomment %}

<section class="pl-sec" id="bundles" data-scene="3">
  <div class="pl-wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="pl-glass pl-sec-pad pl-rv" style="margin-bottom: 16px;">
        <div class="panel-head" style="margin-bottom: 0;">
          {%- if section.settings.eyebrow != blank -%}
            <span class="pl-kicker">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <p class="pl-lede" style="margin: 0 auto; max-width: 54ch;">{{ section.settings.description | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="pl-tiers">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tier' -%}
          {%- assign has_five = false -%}
          {%- assign illustration_count = 0 -%}
          {%- if block.settings.illustration_1 != blank -%}{%- assign illustration_count = illustration_count | plus: 1 -%}{%- endif -%}
          {%- if block.settings.illustration_2 != blank -%}{%- assign illustration_count = illustration_count | plus: 1 -%}{%- endif -%}
          {%- if block.settings.illustration_3 != blank -%}{%- assign illustration_count = illustration_count | plus: 1 -%}{%- endif -%}
          {%- if block.settings.illustration_4 != blank -%}{%- assign illustration_count = illustration_count | plus: 1 -%}{%- endif -%}
          {%- if block.settings.illustration_5 != blank -%}{%- assign illustration_count = illustration_count | plus: 1 -%}{%- endif -%}
          {%- if illustration_count >= 5 -%}
            {%- assign has_five = true -%}
          {%- endif -%}

          {%- assign delay_class = '' -%}
          {%- if forloop.index == 2 -%}
            {%- assign delay_class = 'pl-rv-d2' -%}
          {%- elsif forloop.index == 3 -%}
            {%- assign delay_class = 'pl-rv-d4' -%}
          {%- endif -%}

          <article class="pl-glass pl-tier pl-rv {{ delay_class }} {% if block.settings.is_best %}best{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank -%}
              <span class="tag">{{ block.settings.tag | escape }}</span>
            {%- endif -%}

            <div class="pl-tierpix {% if has_five %}five{% endif %}" aria-hidden="true">
              {%- if block.settings.illustration_1 != blank -%}
                <span class="pimg {{ block.settings.illustration_1 }}" role="img" aria-label="Bundle item 1"></span>
              {%- endif -%}
              {%- if block.settings.illustration_2 != blank -%}
                <span class="pimg {{ block.settings.illustration_2 }}" role="img" aria-label="Bundle item 2"></span>
              {%- endif -%}
              {%- if block.settings.illustration_3 != blank -%}
                <span class="pimg {{ block.settings.illustration_3 }}" role="img" aria-label="Bundle item 3"></span>
              {%- endif -%}
              {%- if block.settings.illustration_4 != blank -%}
                <span class="pimg {{ block.settings.illustration_4 }}" role="img" aria-label="Bundle item 4"></span>
              {%- endif -%}
              {%- if block.settings.illustration_5 != blank -%}
                <span class="pimg {{ block.settings.illustration_5 }}" role="img" aria-label="Bundle item 5"></span>
              {%- endif -%}
            </div>

            <div class="qty">
              {{ block.settings.qty | escape }}
              <small>{{ block.settings.qty_unit | default: 'Products' | escape }}</small>
            </div>

            <div class="price">
              {{ block.settings.price | escape }}
              {%- if block.settings.compare_price != blank -%}
                <s>{{ block.settings.compare_price | escape }}</s>
              {%- endif -%}
            </div>

            {%- if block.settings.price_subtitle != blank -%}
              <p class="body-s" style="font-size: 12px; margin: 0 0 16px;">{{ block.settings.price_subtitle | escape }}</p>
            {%- endif -%}

            <ul>
              {%- if block.settings.bullet_1 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings.bullet_1 | escape }}
                </li>
              {%- endif -%}
              {%- if block.settings.bullet_2 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings.bullet_2 | escape }}
                </li>
              {%- endif -%}
              {%- if block.settings.bullet_3 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings.bullet_3 | escape }}
                </li>
              {%- endif -%}
              {%- if block.settings.bullet_4 != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings.bullet_4 | escape }}
                </li>
              {%- endif -%}
            </ul>

            <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.cta_link | default: '#shop' }}">
              {{ block.settings.cta_text | default: 'Build this box' | escape }}
              {%- if block.settings.is_best -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width: 13px; height: 13px; margin-left: 6px;"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              {%- endif -%}
            </a>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

