{% comment %}
  Purelane Pillars Section
  Displays the 3-column brand characteristic pillars.
{% endcomment %}

<section class="pl-sec" id="how" data-scene="2">
  <div class="pl-wrap">
    <div class="pl-pillars">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pillar' -%}
          {%- capture delay_class -%}
            {%- cycle '', 'pl-rv-d1', 'pl-rv-d2' -%}
          {%- endcapture -%}
          <article class="pl-glass pl-pillar pl-rv {{ delay_class | strip }}" {{ block.shopify_attributes }}>
            <span class="pl-pillar-pi">
              {%- case block.settings.icon -%}
                {%- when 'scrubbing' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8.5" r="3.2"/><circle cx="16.4" cy="6.6" r="2.2"/><circle cx="15" cy="13" r="2.8"/><circle cx="8.6" cy="15.6" r="2.1"/><path d="M4 21h16"/></svg>
                {%- when 'clean' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {%- when 'safe' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
              {%- endcase -%}
            </span>
            <h3 class="pl-d3">{{ block.settings.title }}</h3>
            <p class="pl-body-s">{{ block.settings.text }}</p>
            <a class="btn btn-ghost btn-sm" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pillars",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon Artwork",
          "options": [
            { "value": "scrubbing", "label": "Less Scrubbing (Bubbles)" },
            { "value": "clean", "label": "Clean Ingredients (Shield Check)" },
            { "value": "safe", "label": "Safe (Heart)" }
          ],
          "default": "scrubbing"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Pillar Title",
          "default": "Less scrubbing"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Pillar Description",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link Target",
          "default": "/#shop"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Button Label",
          "default": "Learn more"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "scrubbing",
            "title": "Less scrubbing",
            "text": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.",
            "link": "/#shop"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "clean",
            "title": "Clean ingredients",
            "text": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.",
            "link": "/#ingredients"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "safe",
            "title": "Safe around everyone",
            "text": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.",
            "link": "/#proof"
          }
        }
      ]
    }
  ]
}
{% endschema %}
{% comment %} force-sync-1 {% endcomment %}
