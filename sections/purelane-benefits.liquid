<section class="sec" id="whybundles" data-scene="4">
  <div class="wrap">
    <div class="glass sec-pad pl-rv">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="panel-head">
          {%- if section.settings.eyebrow != blank -%}
            <span class="pl-kicker">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}
      
      <div class="wb">
        {%- for block in section.blocks -%}
          <div class="wb-i" {{ block.shopify_attributes }}>
            <span class="ci">
              {%- case block.settings.icon -%}
                {%- when 'dollar' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v18"/>
                    <path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/>
                  </svg>
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="4" width="16" height="16" rx="3.4"/>
                    <path d="m8.4 12.2 2.4 2.4 4.8-5"/>
                  </svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/>
                  </svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2.6 16.4V7.2h10.2v9.2"/>
                    <path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/>
                    <circle cx="6.6" cy="18" r="1.9"/>
                    <circle cx="16.6" cy="18" r="1.9"/>
                  </svg>
              {%- endcase -%}
            </span>
            {%- if block.settings.title != blank -%}
              <h4>{{ block.settings.title | escape }}</h4>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p>{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Benefits Grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why bundles beat buying single"
    }
  ],
  "blocks": [
    {
      "type": "benefit_card",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon Type",
          "options": [
            {
              "value": "dollar",
              "label": "Save / Price"
            },
            {
              "value": "check",
              "label": "Checkmark / Flat Price"
            },
            {
              "value": "star",
              "label": "Star / Experts"
            },
            {
              "value": "truck",
              "label": "Truck / Shipping"
            }
          ],
          "default": "dollar"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Benefit Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Card Description",
          "default": "Benefit detail description text goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Benefits Grid",
      "blocks": [
        {
          "type": "benefit_card",
          "settings": {
            "icon": "dollar",
            "title": "Save up to 45%",
            "description": "Versus buying the same products separately"
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "check",
            "title": "One flat price",
            "description": "No calculators, no comparing carts"
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "star",
            "title": "Curated by experts",
            "description": "Products picked to work well together"
          }
        },
        {
          "type": "benefit_card",
          "settings": {
            "icon": "truck",
            "title": "Free shipping always",
            "description": "Included on every bundle, all India"
          }
        }
      ]
    }
  ]
}
{% endschema %}
