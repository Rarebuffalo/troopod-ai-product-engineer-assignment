<section class="purelane-section-wrapper" id="shop" data-scene="3">
  <div class="pl-wrap" style="padding: 60px 0;">
    <div style="text-align: center; margin-bottom: 40px;">
      <span class="pl-kicker">{{ section.settings.kicker }}</span>
      <h2 class="pl-d2" style="margin-top: 10px;">{{ section.settings.title }}</h2>
    </div>
    <div style="text-align: center; color: var(--pl-paper-2);">
      <p>Product Grid Placeholder (Collection: {{ section.settings.collection.title | default: 'None selected' }})</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "class": "purelane-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
